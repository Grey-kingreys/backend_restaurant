
#  .env.example — Restaurant Manager Pro (backend DRF)
#  Copier ce fichier en .env et remplir les valeurs
#  cp .env.example .env


# DJANGO

SECRET_KEY=changez-moi-avec-une-vraie-cle-secrete
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1


# BASE DE DONNÉES — PostgreSQL

DB_NAME=backend_db
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable
# En production (Neon.tech) : DB_SSLMODE=require


# JWT

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7


# CORS — origines autorisées
# Séparer par des virgules, sans espaces

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:8080


# EMAIL (pour les rapports Celery)
# Utiliser un mot de passe d'application Gmail
# https://myaccount.google.com/apppasswords


EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=votre@email.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=votre@email.com
REPORT_EMAIL_TO=admin@restaurant.com


# REDIS + CELERY (Phase 8)

REDIS_URL=redis://localhost:6379/0


# SUPER ADMIN — bootstrap du compte plateforme (create_superadmin)
# En PROD : OBLIGATOIRE (le seed de démo étant désactivé, c'est le seul moyen d'avoir un
# compte). Le super admin se connecte par EMAIL → les deux variables sont requises.
# En DEV : inutile (le seed_demo crée déjà « superadmin » / mot de passe Soul2001).

SUPERADMIN_PASSWORD=un_mot_de_passe_fort
SUPERADMIN_EMAIL=admin@mondomaine.com
SUPERADMIN_LOGIN=superadmin
# SUPERADMIN_RESET_PASSWORD=true   # force la réinit. du mdp d'un compte existant


# PRODUCTION — reverse-proxy & sécurité (Dokploy / Traefik)
# Origines HTTPS de confiance pour le CSRF (admin Django), séparées par des virgules.

CSRF_TRUSTED_ORIGINS=https://api.mondomaine.com,https://mondomaine.com


# PRODUCTION — étapes de démarrage de l'entrypoint (défaut: true = comportement dev)
# En prod, le conteneur backend est tout-en-un : supervisord lance gunicorn + celery
# worker + celery beat. Réglages typiques du service web en prod :
#   RUN_MAKEMIGRATIONS=false   RUN_SEED=false
# RUN_MAKEMIGRATIONS=false
# RUN_SEED=false

# Celery intégré (défaut true) : worker + beat dans le conteneur backend via supervisord.
# Mettre false pour désactiver Celery dans ce conteneur (ex. worker/beat en services dédiés).
# RUN_CELERY=true
# GUNICORN_WORKERS=3
